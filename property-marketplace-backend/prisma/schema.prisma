datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
   id                    Int                 @id @default(autoincrement())
  email                 String              @unique
  password              String?
  name                  String?
  phone                 String?
  avatar                String?
  provider              String?             // 'GOOGLE' or 'LOCAL'
  isActive              Boolean             @default(true)
  emailVerified         Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  
  // Relations
  userRoles      UserRole[]          @relation("UserUserRoles")
  assignedRoles  UserRole[]          @relation("AdminAssigned")

  // Property Relations
  ownedProperties       Property[]        @relation("PropertyOwner")
  listedProperties      Property[]        @relation("PropertyLister")
  propertyHistoriesFrom PropertyHistory[] @relation("PropertyOwnerfrom")
  propertyHistoriesTo   PropertyHistory[] @relation("PropertyOwnerto")

  // Messages
  sentMessages          Message[]         @relation("SentMessages")
  receivedMessages      Message[]         @relation("ReceivedMessages")

   notifications         Notification[]    @relation("UserNotifications")

  // Transactions
  buyerTransactions     Transaction[]     @relation("BuyerTransactions")
  sellerTransactions    Transaction[]     @relation("SellerTransactions")

  // Disputes
  complaintsMade        Dispute[]         @relation("DisputeComplainant")
  complaintsReceived    Dispute[]         @relation("DisputeRespondent")
  resolvedDisputes      Dispute[]         @relation("ResolvedBy")

  // Admin Activities
  verifiedProperties    Property[]        @relation("VerifiedBy")
  processedTransactions Transaction[]     @relation("ProcessedBy")

  // Audit trail
  createdByAdmin        User?             @relation("AdminCreated", fields: [createdByAdminId], references: [id])
  createdByAdminId      Int?
  createdUsers          User[]            @relation("AdminCreated")
  paystackRecipientCode String? 
  paystackSubaccountId  String?  

  likedProperties       PropertyLike[]      @relation("UserLikes")

    // New offer relations
  buyerOffers     Offer[] @relation("BuyerOffers")
  sellerOffers    Offer[] @relation("SellerOffers")
  offerCounters   OfferCounter[]
  offerMessages   OfferMessage[]
}

model Notification {
  id                    Int                 @id @default(autoincrement())
  userId                Int
  type                  NotificationType
  title                 String
  message               String              @db.Text
  relatedPropertyId     String?
  relatedTransactionId  String?
  relatedDisputeId      Int?
  metadata              Json?
  isRead                Boolean             @default(false)
  createdAt             DateTime            @default(now())
  readAt                DateTime?

  // Relations
  user                  User                @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  property              Property?           @relation("NotificationProperty", fields: [relatedPropertyId], references: [propertyId], onDelete: SetNull)
  transaction           Transaction?        @relation("NotificationTransaction", fields: [relatedTransactionId], references: [transactionId], onDelete: SetNull)
  dispute               Dispute?            @relation("NotificationDispute", fields: [relatedDisputeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}
model Role {
  id            Int        @id @default(autoincrement())
  name          String     @unique
  description   String?
  permissions   String[]
  createdAt     DateTime   @default(now())

  // Relations
  userRoles     UserRole[]
}

model UserRole {
  id         Int   @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedBy Int?

  // Relations
  user     User @relation("UserUserRoles", fields: [userId], references: [id])
  role     Role @relation(fields: [roleId], references: [id])
  assigner User? @relation("AdminAssigned", fields: [assignedBy], references: [id])
}


model Property {
  id              Int              @id @default(autoincrement())
  propertyId      String           @unique @default(cuid())
  title           String
  description     String
  price           Float
  type            PropertyType
  location        String
  coordinates     Json?
  images          String[]
  amenities       String[]
  specifications  Json?

  bedrooms        Int?             // Number of bedrooms
  bathrooms       Int?             // Number of bathrooms
  area            Float?

  // Ownership & Listing
  currentOwner    User             @relation("PropertyOwner", fields: [currentOwnerId], references: [id])
  currentOwnerId  Int
  listedBy        User?            @relation("PropertyLister", fields: [listedById], references: [id])
  listedById      Int?

  // Status
  status          PropertyStatus   @default(DRAFT)
  isVerified      Boolean          @default(false)
  verifiedBy      User?            @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedById    Int?
  verifiedAt      DateTime?

  // Timestamps
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  listedAt        DateTime?
  soldAt          DateTime?

  // Relations
  transactions    Transaction[]
  propertyHistory PropertyHistory[]
  disputes        Dispute[]        @relation("DisputeProperty")
  //notifications
  notifications         Notification[]      @relation("NotificationProperty")

  likesCount    Int             @default(0)
  likes         PropertyLike[]  @relation("PropertyLikes")

    //new Offers Relations
   offers      Offer[]

  @@index([propertyId])
  @@index([currentOwnerId])
  @@index([status])
}

model PropertyLike {
  id          Int      @id @default(autoincrement())
  userId      Int
  propertyId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation("UserLikes", fields: [userId], references: [id], onDelete: Cascade)
  property    Property @relation("PropertyLikes", fields: [propertyId], references: [propertyId], onDelete: Cascade)

  // Ensure user can only like a property once
  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("property_likes")
}

model PropertyHistory {
  id            Int                @id @default(autoincrement())
  propertyId    String
  fromOwnerId   Int?
  toOwnerId     Int
  transactionId String?               @unique
  price         Float?
  eventType     PropertyEventType
  eventDate     DateTime           @default(now())
  notes         String?

  property      Property           @relation(fields: [propertyId], references: [propertyId])
  fromOwner     User?              @relation("PropertyOwnerfrom", fields: [fromOwnerId], references: [id])
  toOwner       User               @relation("PropertyOwnerto", fields: [toOwnerId], references: [id])
  transaction   Transaction?       @relation(fields: [transactionId], references: [transactionId])           


  @@index([propertyId])
}

model Transaction {
  id                Int               @id @default(autoincrement())
  transactionId     String            @unique @default(cuid())
  amount            Float
  status            TransactionStatus @default(PENDING)

  // Parties
  buyer             User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  buyerId           Int
  seller            User              @relation("SellerTransactions", fields: [sellerId], references: [id])
  sellerId          Int

  // Property
  property          Property          @relation(fields: [propertyId], references: [propertyId])
  propertyId        String

  // Escrow
  escrowAmount      Float?
  escrowReleased    Boolean           @default(false)
  escrowReleasedBy  User?             @relation("ProcessedBy", fields: [escrowReleasedById], references: [id])
  escrowReleasedById Int?
  escrowReleasedAt  DateTime?

  // Payment
  paymentMethod     String?
  paymentReference  String?

  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  completedAt       DateTime?

  // Relations
  propertyHistory   PropertyHistory?
  disputes          Dispute[]         @relation("DisputeTransaction")

  //notifications
  notifications         Notification[]      @relation("NotificationTransaction")

  offerId     String?
  offer       Offer? @relation(fields: [offerId], references: [offerId])

  @@index([transactionId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model Dispute {
  id             Int             @id @default(autoincrement())
  disputeId      String          @unique @default(cuid())
  title          String
  description    String
  status         DisputeStatus   @default(OPEN)
  priority       DisputePriority @default(MEDIUM)

  // Parties
  complainant    User            @relation("DisputeComplainant", fields: [complainantId], references: [id])
  complainantId  Int
  respondent     User            @relation("DisputeRespondent", fields: [respondentId], references: [id])
  respondentId   Int

  // Related Entities
  property       Property?       @relation("DisputeProperty", fields: [propertyId], references: [id])
  propertyId     Int?
  transaction    Transaction?    @relation("DisputeTransaction", fields: [transactionId], references: [id])
  transactionId  Int?

  // Resolution
  resolvedBy     User?           @relation("ResolvedBy", fields: [resolvedById], references: [id])
  resolvedById   Int?
  resolvedAt     DateTime?
  resolution     String?

  notifications         Notification[]      @relation("NotificationDispute")

  // Timestamps
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([disputeId])
  @@index([status])
}

model Offer {
  id          Int      @id @default(autoincrement())
  offerId     String   @unique @default(cuid()) // Public facing ID
  
  // Core offer details
  propertyId  String
  buyerId     Int
  sellerId    Int
  amount      Float
  message     String?  @db.Text
  
  // Offer lifecycle
  status      OfferStatus @default(PENDING)
  expiresAt   DateTime?
  respondedAt DateTime?
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  property    Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  buyer       User     @relation("BuyerOffers", fields: [buyerId], references: [id])
  seller      User     @relation("SellerOffers", fields: [sellerId], references: [id])
  
  // Related entities
  counterOffers OfferCounter[]
  transactions  Transaction[] // Links to payment after acceptance
  messages      OfferMessage[]
  
  @@map("offers")
}

model OfferCounter {
  id          Int      @id @default(autoincrement())
  
  offerId     Int
  fromUserId  Int      // Who made the counter (buyer or seller)
  amount      Float
  message     String?  @db.Text
  
  status      CounterStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  offer       Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  fromUser    User  @relation(fields: [fromUserId], references: [id])
  
  @@map("offer_counters")
}
model OfferMessage {
  id          Int      @id @default(autoincrement())
  
  offerId     Int
  fromUserId  Int
  content     String   @db.Text
  messageType OfferMessageType @default(GENERAL)
  
  createdAt   DateTime @default(now())
  isRead      Boolean  @default(false)
  
  // Relations
  offer       Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  fromUser    User  @relation(fields: [fromUserId], references: [id])
  
  @@map("offer_messages")
}
model Message {
  id         Int      @id @default(autoincrement())
  content    String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId   Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId Int
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  isReported Boolean @default(false)

  @@index([senderId])
  @@index([receiverId])
}

// Enums
enum PropertyType {
OFFICE
APPARTMENT
LAND
}

enum PropertyStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  LISTED
  UNDER_OFFER
  SOLD
  DELISTED
  SUSPENDED
  REJECTED
}

enum PropertyEventType {
  CREATED
  LISTED
  DELISTED
  SOLD
  TRANSFERRED
  VERIFIED
  SUSPENDED
  SUBMITTED
}

enum TransactionStatus {
  PENDING
  ESCROW
  PAYMENT_CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
  ESCALATED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum OfferStatus {
  PENDING       // Waiting for seller response
  ACCEPTED      // Seller accepted, ready for payment
  REJECTED      // Seller rejected
  COUNTERED     // Seller made counter-offer
  EXPIRED       // Offer expired
  WITHDRAWN     // Buyer withdrew offer
  COMPLETED     // Payment completed
}
enum CounterStatus {
  PENDING       // Waiting for response
  ACCEPTED      // Counter-offer accepted
  REJECTED      // Counter-offer rejected
  SUPERSEDED    // Replaced by newer counter
}

enum OfferMessageType {
  GENERAL       // Regular message
  SYSTEM        // System generated (status changes, etc.)
  COUNTER_OFFER // Counter offer message
}
enum NotificationType {
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  PROPERTY_SUSPENDED
  PROPERTY_VERIFICATION_REQUIRED
  TRANSACTION_ESCROW_RELEASED
  TRANSACTION_PAYMENT_CONFIRMED
  TRANSACTION_COMPLETED
  DISPUTE_RESOLVED
  DISPUTE_ESCALATED
  MESSAGE_RECEIVED
  ACCOUNT_SUSPENDED
  SYSTEM_ANNOUNCEMENT
}